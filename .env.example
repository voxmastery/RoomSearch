# From https://portal.usemoss.dev — required for a real Moss query.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Optional directory for the downloaded Moss index cache.
# MOSS_CACHE_PATH=data/moss-cache

# Only when the two keys above are empty. Labeled in the UI as mock, never as Moss.
# DEMO_MOCK_MOSS=1

# Brain + journal directory. Defaults to ./data
# ROOMSEARCH_DATA=data
